{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate Dashboard 🤖',
  },
  rebaseWhen: 'conflicted',
  prConcurrentLimit: 150,
  prHourlyLimit: 0,
  automergeType: 'pr',
  pinDigests: true,
  separateMinorPatch: true,
  semanticCommits: 'enabled',
  // Keep the hook versions in .pre-commit-config.yaml up to date (off by default in Renovate)
  'pre-commit': {
    enabled: true,
  },
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  extends: [
    'config:recommended',
    'github>HoMS1987/TalosCluster//.github/renovate/customManagers.json5',
    'github>HoMS1987/TalosCluster//.github/renovate/kinds.json5',
    'github>HoMS1987/TalosCluster//.github/renovate/semanticCommits.json5',
    'github>HoMS1987/TalosCluster//.github/renovate/labels.json5',
    'github>HoMS1987/TalosCluster//.github/renovate/autoMerge.json5',
    'github>HoMS1987/TalosCluster//.github/renovate/groups.json5',
    'github>HoMS1987/TalosCluster//.github/renovate/customVersioning.json5',
    'github>HoMS1987/TalosCluster//.github/renovate/talos.json5',
    'github>HoMS1987/TalosCluster//.github/renovate/truechartsSchema.json5',
  ],
}
