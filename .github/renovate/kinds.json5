{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "flux": {
    "managerFilePatterns": [
      "/(^|/)clusters/.+\\.ya?ml$/",
      "/(^|/)repositories/.+\\.ya?ml$/"
    ],
    "pinDigests": false,
    "branchPrefix": "renovate/flux-"
  },
  "github-actions": {
    "branchPrefix": "renovate/githubactions-"
  },
  "devcontainer": {
    "branchPrefix": "renovate/devcontainer-"
  }
}
